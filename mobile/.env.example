# このファイルを .env にコピーして使う。.env は git 管理外。
#   copy .env.example .env

# API のベース URL。
#
# 【重要】Expo Go の実機は開発 PC とは別の端末なので、localhost では届かない。
# 開発 PC の LAN IP を指定する。IP は次のコマンドで確認できる。
#   ipconfig | findstr IPv4
#
# ポートを切り替えるだけで、同じアプリが Java 実装と Kotlin 実装のどちらにも繋がる。
#   8080 → Java 実装
#   8081 → Kotlin 実装
# これが「2 実装が同じ契約を満たしている」ことの一番わかりやすい確認方法になる。
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080/api
