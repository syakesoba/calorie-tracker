# このファイルを .env にコピーして使う。.env は git 管理外。
#   cp .env.example .env

# --- データベース ---------------------------------------------------------
DB_HOST=localhost
# ローカルに常駐している PostgreSQL 16 / 18 と衝突しないよう 55432 を使う
DB_PORT=55432
DB_NAME=calorie
TEST_DB_NAME=calorie_test

# Java 側（Flyway でスキーマを所有する）
JAVA_DB_USER=app_java
JAVA_DB_PASSWORD=app_java_pw

# Kotlin 側（DML のみ。Phase 2 で使用）
KOTLIN_DB_USER=app_kotlin
KOTLIN_DB_PASSWORD=app_kotlin_pw

# --- JWT ------------------------------------------------------------------
# HS256 の署名鍵。32 バイト以上必須。本番では必ず別の値にする。
# 生成例: openssl rand -base64 48
JWT_SECRET=local-development-only-secret-key-change-me-please-32bytes+

# アクセストークンの有効期間（分）
JWT_ACCESS_TOKEN_MINUTES=30
# リフレッシュトークンの有効期間（日）
JWT_REFRESH_TOKEN_DAYS=30
